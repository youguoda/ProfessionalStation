# 本地持久化数据目录（默认 .data）
DATA_DIR=.data

# AI（OpenAI 兼容接口，未配置时自动降级为本地启发式）
# 默认使用 DeepSeek：https://platform.deepseek.com 获取 API Key
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 也兼容 OpenAI / Moonshot / 内网自建（vLLM、one-api 等）：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 端点不支持 response_format: json_object 时置 0（症状：结构化调用一律 HTTP 400）。
# 关掉后改由提示词要求 JSON，parseJsonLoose 兜底，功能不丢。
# 用 deploy/preflight-ai.sh 探一下就知道要不要开。
# AI_JSON_MODE=0

# 单次非流式 AI 调用超时毫秒数（默认 60000，流式自动放宽到 3 倍）。
# 端点挂起时聊天/拆分不会无限悬着。
# AI_TIMEOUT_MS=60000

# Qwen3 类推理模型的思考控制（默认开）：关闭思考时注入
# chat_template_kwargs.enable_thinking=false，首 token 从秒级降到亚秒。
# 端点不认这个参数（HTTP 400）就置 0 停止注入。马力的「深度思考」
# 开关存在 settings.agentThinking，默认关。
# AI_THINKING_CONTROL=1

# HTTP Basic Auth（src/middleware.ts）：应用零鉴权，端口暴露在内网时
# 两个都设置才启用；都留空则完全放行（本地开发零摩擦）。
# 生产部署走 Nginx basic auth 的话这里可以不设。
# PS_AUTH_USER=
# PS_AUTH_PASS=
